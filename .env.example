# 开发环境 API 代理目标（vite dev 时 /console/v1 代理到此处）
# 生产构建无需配置：API 走同域相对路径 /console/v1
VITE_API_PROXY_TARGET=

# 站点名兜底（common 未加载完时，登录/注册页标题用此值；留空回退 'FurLL 客户中心'）
VITE_APP_SITE_NAME=

# 浏览器标题栏与 SEO meta（index.html 用 %VITE_*% 占位替换）
VITE_APP_TITLE=FurLL 客户中心
VITE_APP_DESCRIPTION=魔方财务前台模板 FurLLV10
VITE_APP_KEYWORDS=魔方财务,IDC,FurLLV10

# 测试开关：=1 强制所有产品详情走官方 pc/default 壳解析（legacy iframe），
# 临时关闭已适配模块的 React 自定义解析，用于验证未适配模块能否按官方方法渲染控制台。
# 默认留空/0 为自定义解析（已适配模块走 React，未适配模块走官方壳）。
VITE_FORCE_OFFICIAL_CONSOLE=
