# 开发环境 API 代理目标（vite dev 时 /console/v1 代理到此处）
# 生产构建无需配置：API 走同域相对路径 /console/v1
VITE_API_PROXY_TARGET=

# 站点名兜底（common 未加载完时，登录/注册页标题用此值；留空回退 'FurLL 客户中心'）
VITE_APP_SITE_NAME=

# 浏览器标题栏与 SEO meta（index.html 用 %VITE_*% 占位替换）；建议填写自己的站点信息
VITE_APP_TITLE=
VITE_APP_DESCRIPTION=
VITE_APP_KEYWORDS=

# 弹出提示位置：bottom-right（默认）、top-right、top-center、center（页面中间）
VITE_TOAST_POSITION=bottom-right

# 强制官方解析开关（release.sh 固定为 1）：所有产品详情页走官方 pc/default 壳。
VITE_FORCE_OFFICIAL_CONSOLE=1

# 强制官方商品配置解析开关（release.sh 固定为 1）：所有商品配置页走官方 pc/default 壳。
VITE_FORCE_OFFICIAL_GOODS=1
